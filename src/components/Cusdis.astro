---
interface Props {
	pageId: string;
	pageUrl: string;
	pageTitle: string;
	lang?: 'pt' | 'en';
}

const { pageId, pageUrl, pageTitle, lang = 'en' } = Astro.props;
const heading = lang === 'pt' ? 'Comentários' : 'Comments';
---

<section class="comments-section">
	<h2>{heading}</h2>
	<div id="cusdis_thread"
		data-host="https://cusdis.com"
		data-app-id="0da35e72-68a9-44bd-8fca-48e0094fcbd6"
		data-page-id={pageId}
		data-page-url={pageUrl}
		data-page-title={pageTitle}
	></div>
	<script async defer src="https://cusdis.com/js/cusdis.es.js"></script>
</section>

<style>
	.comments-section {
		width: 720px;
		max-width: calc(100% - 2em);
		margin: 2em auto 4em;
		padding: 2em;
		background: var(--bg-glass);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border: 1px solid var(--border-glass);
		border-radius: 24px;
		box-shadow: var(--box-shadow);
	}
	h2 {
		margin: 0 0 1.5em 0;
		color: var(--text-main);
		font-size: 1.4rem;
	}
</style>
