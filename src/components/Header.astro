---
import { BASE, SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';

interface Props {
	lang?: 'pt' | 'en';
	translationHref?: string;
}

const { lang = 'pt', translationHref } = Astro.props;

const isPt = lang === 'pt';
const base = isPt ? `${BASE}/pt` : BASE;
const otherLang = isPt ? 'EN' : 'PT';
const otherHref = translationHref ?? (isPt ? `${BASE}/` : `${BASE}/pt/`);
---

<header class="glass-panel-header">
	<nav>
		<h2><a href={isPt ? `${BASE}/pt/` : `${BASE}/`} class="gradient-text site-title">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href={`${base}/`}>{!isPt ? 'Home' : 'Início'}</HeaderLink>
			<HeaderLink href={`${base}/blog`}>Blog</HeaderLink>
			<HeaderLink href={`${base}/about`}>{!isPt ? 'About' : 'Sobre'}</HeaderLink>
		</div>
		<div class="right-links">
			<a href={otherHref} class="lang-switch">{otherLang}</a>
		</div>
	</nav>
</header>
<style>
	.glass-panel-header {
		background: rgba(15, 23, 42, 0.7);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--border-glass);
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
	}
	header {
		margin: 0;
		padding: 1em 2em;
		position: sticky;
		top: 0;
		z-index: 100;
	}
	h2 {
		margin: 0;
		font-size: 1.4em;
		font-weight: 800;
	}
	h2 a {
		text-decoration: none;
		display: inline-block;
		transition: transform 0.2s;
	}
	h2 a:hover {
		transform: scale(1.02);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1000px;
		margin: 0 auto;
	}
	.internal-links {
		display: flex;
		gap: 1.5em;
	}
	nav a:not(.site-title):not(.lang-switch) {
		padding: 0.5em;
		color: var(--text-muted);
		text-decoration: none;
		font-weight: 600;
		position: relative;
		transition: color 0.3s ease;
	}
	nav a:not(.site-title):not(.lang-switch)::after {
		content: '';
		position: absolute;
		width: 0;
		height: 2px;
		bottom: 0;
		left: 0;
		background-color: var(--accent);
		transition: width 0.3s ease;
		border-radius: 2px;
	}
	nav a:not(.site-title):not(.lang-switch):hover {
		color: var(--text-main);
	}
	nav a:not(.site-title):not(.lang-switch):hover::after,
	nav a.active::after {
		width: 100%;
	}
	nav a.active {
		color: var(--text-main);
	}
	.right-links {
		display: flex;
		align-items: center;
	}
	.lang-switch {
		font-size: 0.85em;
		font-weight: 700;
		padding: 0.4em 1em;
		border-radius: 20px;
		background: rgba(139, 92, 246, 0.1);
		border: 1px solid rgba(139, 92, 246, 0.3);
		color: var(--accent-light) !important;
		transition: all 0.3s ease;
		text-decoration: none;
	}
	.lang-switch:hover {
		background: rgba(139, 92, 246, 0.3);
		border-color: rgba(139, 92, 246, 0.5);
		color: #fff !important;
		box-shadow: 0 0 15px rgba(139, 92, 246, 0.4);
		text-shadow: none;
	}
	@media (max-width: 720px) {
		.right-links {
			display: none;
		}
		nav {
			flex-direction: column;
			gap: 1em;
		}
	}
</style>
