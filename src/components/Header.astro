---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';

interface Props {
	lang?: 'pt' | 'en';
	translationHref?: string;
}

const { lang = 'pt', translationHref } = Astro.props;

const isEn = lang === 'en';
const siteBase = import.meta.env.BASE_URL;
const base = isEn ? `${siteBase}en` : siteBase.slice(0, -1);
const otherLang = isEn ? 'PT' : 'EN';
const otherHref = translationHref ?? (isEn ? siteBase : `${siteBase}en/`);
---

<header>
	<nav>
		<h2><a href={isEn ? `${siteBase}en/` : siteBase}>{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href={`${base}/`}>{isEn ? 'Home' : 'Início'}</HeaderLink>
			<HeaderLink href={`${base}/blog`}>Blog</HeaderLink>
			<HeaderLink href={`${base}/about`}>{isEn ? 'About' : 'Sobre'}</HeaderLink>
		</div>
		<div class="right-links">
			<a href={otherHref} class="lang-switch">{otherLang}</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.right-links {
		display: flex;
		align-items: center;
	}
	.lang-switch {
		font-size: 0.85em;
		font-weight: 700;
		letter-spacing: 0.05em;
		padding: 0.3em 0.7em;
		border: 2px solid var(--accent);
		border-radius: 4px;
		color: var(--accent) !important;
		border-bottom: 2px solid var(--accent) !important;
	}
	.lang-switch:hover {
		background: var(--accent);
		color: white !important;
	}
	@media (max-width: 720px) {
		.right-links {
			display: none;
		}
	}
</style>
