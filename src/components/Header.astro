---
import { BASE, SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';

interface Props {
	lang?: 'pt' | 'en';
	translationHref?: string;
}

const { lang = 'pt', translationHref } = Astro.props;

const isPt = lang === 'pt';
const base = isPt ? `${BASE}/pt` : BASE;
const otherLang = isPt ? 'EN' : 'PT';
const otherHref = translationHref ?? (isPt ? `${BASE}/` : `${BASE}/pt/`);
---

<header class="terminal-header">
	<nav>
		<h2><a href={isPt ? `${BASE}/pt/` : `${BASE}/`} class="terminal-site-title">root@{SITE_TITLE}:~#</a></h2>
		<div class="internal-links">
			<HeaderLink href={`${base}/`}>./{!isPt ? 'home' : 'inicio'}</HeaderLink>
			<HeaderLink href={`${base}/blog`}>./blog</HeaderLink>
			<HeaderLink href={`${base}/about`}>./{!isPt ? 'about' : 'sobre'}</HeaderLink>
		</div>
		<div class="right-links">
			<a href={otherHref} class="lang-switch">LANG={otherLang}</a>
		</div>
	</nav>
</header>
<style>
	.terminal-header {
		background: var(--bg-main);
		border-bottom: 1px dashed var(--matrix-green);
		padding: 1em 2em;
		position: sticky;
		top: 0;
		z-index: 100;
	}
	h2 {
		margin: 0;
		font-size: 1.2em;
		font-weight: bold;
	}
	h2 a {
		text-decoration: none;
		color: var(--text-main);
	}
	h2 a:hover {
		background: transparent;
		color: #fff;
		text-shadow: 0 0 8px var(--matrix-green);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1000px;
		margin: 0 auto;
	}
	.internal-links {
		display: flex;
		gap: 1.5em;
	}
	nav a:not(.terminal-site-title) {
		padding: 0.2em 0.5em;
		color: var(--matrix-green);
		text-decoration: none;
		font-weight: bold;
		transition: all 0.2s ease;
	}
	nav a:not(.terminal-site-title):hover,
	nav a.active {
		background-color: var(--matrix-green);
		color: var(--bg-main);
	}
	.right-links {
		display: flex;
		align-items: center;
	}
	.lang-switch {
		font-size: 0.9em;
		font-weight: 700;
		padding: 0.2em 0.5em;
		border: 1px solid var(--matrix-green);
		color: var(--matrix-green);
	}
	.lang-switch:hover {
		background-color: var(--matrix-green);
		color: var(--bg-main);
	}
	@media (max-width: 720px) {
		.right-links {
			display: none;
		}
		nav {
			flex-direction: column;
			gap: 1em;
		}
	}
</style>
