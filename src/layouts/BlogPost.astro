---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Cusdis from '../components/Cusdis.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = (CollectionEntry<'blogPt'> | CollectionEntry<'blogEn'>)['data'] & {
	lang?: 'pt' | 'en';
	translationHref?: string;
};

const { title, description, pubDate, updatedDate, heroImage, lang = 'pt', translationHref } = Astro.props;
const lastUpdatedLabel = lang === 'pt' ? 'Atualizado em' : 'Last updated on';
---

<html lang={lang === 'pt' ? 'pt-BR' : 'en'}>
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border: 1px solid var(--matrix-green);
				box-shadow: 0 0 20px rgba(0, 255, 65, 0.2);
				filter: sepia(100%) hue-rotate(80deg) saturate(400%) contrast(1.2);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 3em 2em;
				color: var(--text-main);
				background: var(--bg-main);
				border: 1px solid var(--border-color);
				margin-top: -3em;
				position: relative;
				z-index: 2;
				box-shadow: 0 0 15px rgba(0, 255, 65, 0.2);
			}
			.title {
				margin-bottom: 2em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
				font-size: 3em;
			}
			.date {
				margin-bottom: 1em;
				color: var(--matrix-dark-green);
				font-weight: bold;
				display: flex;
				justify-content: center;
				align-items: center;
				gap: 1em;
			}
			.last-updated-on {
				font-style: italic;
				opacity: 0.8;
			}
			@media (max-width: 720px) {
				.prose {
					padding: 2em 1em;
					margin-top: -2em;
				}
				.title h1 {
					font-size: 2.2em;
				}
			}
		</style>
	</head>

	<body>
		<Header lang={lang} translationHref={translationHref} />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage as any} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} lang={lang} />
							{
								updatedDate && (
									<div class="last-updated-on">
										{lastUpdatedLabel} <FormattedDate date={updatedDate} lang={lang} />
									</div>
								)
							}
						</div>
						<h1 class="terminal-text">> {title}</h1>
						<hr />
					</div>
					<slot />
				</div>
			</article>
		</main>
		<Cusdis
			pageId={Astro.url.pathname}
			pageUrl={Astro.url.href}
			pageTitle={title}
			lang={lang}
		/>
		<Footer lang={lang} />
	</body>
</html>
