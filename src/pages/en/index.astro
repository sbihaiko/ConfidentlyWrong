---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION.en} />
	</head>
	<body>
		<Header lang="en" />
		<main>
			<h1>Confidently Wrong</h1>
			<p>{SITE_DESCRIPTION.en}</p>
			<p><a href={`${import.meta.env.BASE_URL}en/blog`}>Read articles →</a></p>
		</main>
		<Footer />
	</body>
</html>
