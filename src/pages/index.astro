---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION.pt} />
	</head>
	<body>
		<Header lang="pt" />
		<main>
			<h1>Confidently Wrong</h1>
			<p>{SITE_DESCRIPTION.pt}</p>
			<p><a href={`${import.meta.env.BASE_URL}blog`}>Ver artigos →</a></p>
		</main>
		<Footer />
	</body>
</html>
