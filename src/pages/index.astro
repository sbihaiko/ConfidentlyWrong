---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { BASE, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blogEn'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION.en} />
		<style>
			.hero {
				margin-bottom: 4rem;
				text-align: center;
				padding: 4rem 2rem;
			}
			.subtitle {
				font-size: 1.2rem;
				color: var(--matrix-dark-green);
				max-width: 600px;
				margin: 1.5rem auto 0;
			}
			.post-list {
				list-style: none;
				padding: 0;
				margin: 0;
				display: grid;
				grid-template-columns: 1fr;
				gap: 1.5rem;
			}
			.post-list li {
				display: block;
			}
			.post-list li a {
				display: flex;
				flex-direction: column;
				gap: 0.5rem;
				padding: 1.8rem;
				text-decoration: none;
				color: inherit;
				height: 100%;
				box-sizing: border-box;
				position: relative;
				overflow: hidden;
			}
			.post-title {
				font-size: 1.4rem;
				font-weight: bold;
				color: var(--text-main);
			}
			.post-list li a:hover .post-title,
			.post-list li a:hover .post-description,
			.post-list li a:hover .post-date {
				color: var(--matrix-bright);
			}
			.post-date {
				font-size: 0.9rem;
				color: var(--matrix-dark-green);
				display: flex;
				align-items: center;
				gap: 0.5rem;
				margin-top: auto;
			}
			.post-description {
				font-size: 1rem;
				color: var(--matrix-green);
				margin: 0.5rem 0 1rem;
				line-height: 1.6;
			}
			.all-articles {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				gap: 0.8rem;
				margin-top: 3rem;
				font-weight: bold;
				padding: 1rem 2rem;
				background: transparent;
				border: 1px solid var(--matrix-green);
				color: var(--text-main);
				text-decoration: none;
				transition: all 0.2s;
			}
			.all-articles:hover {
				background: var(--matrix-green);
				color: var(--bg-main);
			}
		</style>
	</head>
	<body>
		<Header lang="en" />
		<main>
			<div class="hero terminal-panel">
				<h1 class="terminal-text">> Confidently Wrong</h1>
				<p class="subtitle">{SITE_DESCRIPTION.en}</p>
			</div>
			
			<h3 style="margin-bottom: 1.5rem; border-bottom: 1px dashed var(--matrix-green); padding-bottom: 0.5rem;">> ./recent-posts</h3>
			
			<ul class="post-list">
				{posts.map((post) => (
					<li>
						<a href={`${BASE}/blog/${post.id}/`} class="terminal-card">
							<span class="post-title">> {post.data.title}</span>
							<span class="post-description">{post.data.description}</span>
							<span class="post-date"><FormattedDate date={post.data.pubDate} lang="en" /></span>
						</a>
					</li>
				))}
			</ul>
			<div style="text-align: center;">
				<a href={`${BASE}/blog`} class="all-articles">
					> cat all_articles.txt
				</a>
			</div>
		</main>
		<Footer lang="en" />
	</body>
</html>
