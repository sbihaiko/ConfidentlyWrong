---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import Header from '../../../components/Header.astro';
import { BASE, SITE_DESCRIPTION, SITE_TITLE } from '../../../consts';

const posts = (await getCollection('blogPt')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION.pt} />
		<style>
			main {
				width: 960px;
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 1rem);
				display: flex;
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li:first-child {
				width: 100%;
				margin-bottom: 2rem;
			}
			ul li:first-child a {
				flex-direction: row;
				align-items: center;
				gap: 2rem;
			}
			ul li:first-child img {
				width: 50%;
				margin: 0;
			}
			.post-content {
				display: flex;
				flex-direction: column;
				justify-content: center;
				flex: 1;
			}
			ul li:first-child .title {
				font-size: 2.5rem;
				margin-bottom: 0.5rem;
			}
			ul li a {
				display: flex;
				flex-direction: column;
				width: 100%;
				padding: 1.5rem;
				box-sizing: border-box;
			}
			ul li img {
				margin-bottom: 1rem;
				width: 100%;
				object-fit: cover;
				border: 1px solid var(--matrix-green);
				transition: transform 0.3s ease;
			}
			.title {
				margin: 0;
				color: var(--text-main);
				line-height: 1.2;
				font-size: 1.5rem;
				font-weight: bold;
			}
			.date {
				margin: 0.5rem 0 0 0;
				color: var(--matrix-dark-green);
				font-size: 0.9rem;
			}
			ul li a:hover .title,
			ul li a:hover .date {
				color: var(--matrix-bright);
			}
			ul a:hover img {
				transform: translateY(-4px);
				box-shadow: 0 12px 30px rgba(0, 255, 65, 0.4);
			}
			@media (max-width: 720px) {
				ul {
					gap: 1.5em;
				}
				ul li {
					width: 100%;
				}
				ul li:first-child a {
					flex-direction: column;
				}
				ul li:first-child img {
					width: 100%;
					margin-bottom: 1rem;
				}
				ul li:first-child .title {
					font-size: 1.8rem;
				}
			}
		</style>
	</head>
	<body>
		<Header lang="pt" translationHref={`${BASE}/blog/`} />
		<main>
			<h1 class="terminal-text" style="margin-bottom: 2rem; text-align: center;">> ls -l /blog/all</h1>
			<section>
				<ul>
					{
						posts.map((post) => (
							<li>
								<a href={`${BASE}/pt/blog/${post.id}/`} class="terminal-card">
									{post.data.heroImage && (
										<Image width={720} height={360} src={post.data.heroImage as any} alt="" />
									)}
									<div class="post-content">
										<h4 class="title">> {post.data.title}</h4>
										<p class="date">
											<FormattedDate date={post.data.pubDate} lang="pt" />
										</p>
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer lang="pt" />
	</body>
</html>
